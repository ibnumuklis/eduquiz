# ---- Public (exposed to the browser; safe to share) ----
# Supabase project URL: Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public site URL used in auth email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server only (NEVER prefix with NEXT_PUBLIC_, never commit) ----
# Optional: enables sending invitation emails from the Invitations page.
SUPABASE_SERVICE_ROLE_KEY=
